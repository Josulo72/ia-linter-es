{
  "name": "textoneitor-workspace",
  "private": true,
  "version": "1.2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "node --test scripts/gate-adjudication.test.mjs && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "gates": "node scripts/corpus-check.mjs && node scripts/gates.mjs",
    "corpus:check": "node scripts/corpus-check.mjs",
    "lint:self": "node packages/linter/dist/cli/main.js lint README.md CHANGELOG.md CONTRIBUTING.md SECURITY.md docs integrations",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0",
    "esbuild": "^0.25.0",
    "yaml": "^2.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
